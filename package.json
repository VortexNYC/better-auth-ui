{
  "name": "@vortex-api/better-auth-ui",
  "version": "0.1.6",
  "description": "Kumo-based React components for Better Auth",
  "license": "MIT",
  "author": "Shlomo Kabareti <shlomo@vortex.nyc>",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./emails": {
      "types": "./dist/emails/index.d.ts",
      "import": "./dist/emails/index.js",
      "default": "./dist/emails/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "tsc --noEmit && prettier --check .",
    "prepublishOnly": "pnpm run build",
    "prepare": "pnpm run build"
  },
  "packageManager": "pnpm@11.13.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VortexNYC/better-auth-ui.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "better-auth",
    "kumo",
    "react",
    "auth",
    "ui"
  ],
  "peerDependencies": {
    "@cloudflare/kumo": ">=2.13.0",
    "@phosphor-icons/react": ">=2.1.10",
    "better-auth": ">=1.6.0",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0",
    "react-email": ">=6.0.0",
    "zod": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "react-email": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cloudflare/kumo": "2.13.2",
    "@phosphor-icons/react": "^2.1.10",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "better-auth": "1.7.2",
    "jsdom": "29.0.1",
    "prettier": "^3.5.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-email": "6.9.5",
    "tsup": "^8.4.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.2",
    "zod": "^4.3.6"
  }
}
